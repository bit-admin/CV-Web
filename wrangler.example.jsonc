// Copy to wrangler.jsonc (gitignored) and set your domain.
{
  "name": "cv-web",
  "compatibility_date": "2026-05-19",
  // The Worker script only runs for /api/* (optional sync); every other request is
  // served directly from static assets, which is free and does not run the script.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // One SQLite-backed Durable Object per sync code (available on the Workers Free plan).
  "durable_objects": {
    "bindings": [{ "name": "SYNC", "class_name": "SyncSpace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncSpace"] }],
  // A custom domain on a zone in your Cloudflare account; remove to use *.workers.dev only.
  "routes": [{ "pattern": "cv.example.com", "custom_domain": true }]
}
