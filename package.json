{
  "name": "cv-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "assets:build": "node scripts/build-runtime-assets.mjs",
    "thumbnails": "node scripts/build-thumbnails.mjs",
    "assets:download": "texlyre-busytex download-assets ./vendor && npm run assets:build",
    "deploy": "npm run build && WRANGLER_WRITE_LOGS=false wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.555.0",
    "pdfjs-dist": "^5.4.449",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "texlyre-busytex": "^1.4.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.7",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "wrangler": "^4.93.0"
  }
}
